DATABASE_URL=postgresql://loadlens:loadlens@localhost:5435/loadlens
PORT=3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
JWT_SECRET=change-me-long-random
ADMIN_KEY=
# Premium-чтение: список валидных API-ключей через запятую (заголовок X-API-Key).
# Пусто → крауд-данные читает только Pro-JWT. Реальные ключи держать в Coolify, не в репозитории.
API_KEYS=
# OSRM routing (по умолчанию публичный демо-сервер; для прода — self-hosted)
OSRM_URL=https://router.project-osrm.org
# EIA diesel price (бесплатный ключ на eia.gov/opendata; без ключа — фолбэк-константа)
EIA_API_KEY=
# Telegram-алерты (без TELEGRAM_BOT_TOKEN фича выключена). USERNAME — для deep-link t.me/<bot>?start=,
# WEBHOOK_SECRET — секрет в пути вебхука POST /api/v1/telegram/webhook/<secret>.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# LoadLens Cloud (браузер в облаке). Без COOLIFY_API_URL фича выключена (/cloud/* → 503, watchdog молчит).
# URL — внутренний адрес Coolify из docker-сети (бэкенд и Coolify на одном сервере), токен — write+deploy.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_CLOUD_SERVER_UUID=f8xhhqagybtdjk14krvrp0kq
COOLIFY_CLOUD_PROJECT_UUID=ocls09doyppd1f5ze0fsjj8r
COOLIFY_CLOUD_ENV_NAME=production
CLOUD_IMAGE_TAG=latest

# Pro trial: сколько дней Pro получает каждый аккаунт один раз (пусто → 14, 0 → новые триалы не выдаются).
TRIAL_DAYS=14

# Оплата Pro через Paddle (спека 2026-10-01). BILLING_MODE: off (пусто) | test (видят только админы) | live.
# PADDLE_ENV: sandbox | production (всё, кроме production, — sandbox). Без API_KEY/CLIENT_TOKEN/PRICE_ID оплата скрыта.
# PADDLE_PRICE_ID — месяц; PADDLE_PRICE_ID_YEARLY — год (пусто → годового тарифа нет).
BILLING_MODE=
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_PRICE_ID_YEARLY=
PADDLE_WEBHOOK_SECRET=

# Fraud Shield ключей не требует: статус/история лицензий — открытые датасеты data.transportation.gov.
