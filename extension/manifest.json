{
  "manifest_version": 3,
  "name": "LoadLens — load scoring for DAT One / Truckstop",
  "version": "0.9.0",
  "description": "Shows how profitable each load is ($/mile after deadhead, fuel and lane market rates).",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.dat.com/*",
    "https://*.truckstop.com/*",
    "https://loadlens.krait.studio/*"
  ],
  "action": {
    "default_title": "LoadLens"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dat.com/*",
        "https://*.truckstop.com/*"
      ],
      "js": [
        "cloud.config.js",
        "cloud.js",
        "vendor/load.model.js",
        "vendor/scoring.js",
        "vendor/planner.js",
        "vendor/fleet.js",
        "vendor/email-template.js",
        "vendor/markets.seed.js",
        "api.js",
        "adapters/adapters.js",
        "adapters/dat.adapter.js",
        "adapters/dat.graphql.js",
        "adapters/truckstop.adapter.js",
        "geo.js",
        "hos.js",
        "drivers.js",
        "alerts.js",
        "csv.js",
        "tabstate.js",
        "equip-filter.js",
        "alert-rules.js",
        "visibility.js",
        "autopilot-policy.js",
        "loads-accumulator.js",
        "view-model.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.dat.com/*"
      ],
      "js": [
        "sse-frames.js",
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
